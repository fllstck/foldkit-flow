{
  "name": "@fllstck/foldkit-flow",
  "version": "0.1.1",
  "description": "A flow / node-graph canvas for Foldkit: one Model, pure update, every effect at a named seam.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp style/flow.css dist/style.css",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "effect": "~4.1.0",
    "foldkit": "0.170.0"
  },
  "dependencies": {
    "@xyflow/system": "0.0.84"
  },
  "devDependencies": {
    "@effect/platform-browser": "~4.1.0",
    "@foldkit/vite-plugin": "0.29.0",
    "effect": "~4.1.0",
    "foldkit": "0.170.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fllstck/foldkit-flow.git",
    "directory": "packages/flow"
  },
  "homepage": "https://github.com/fllstck/foldkit-flow#readme",
  "bugs": {
    "url": "https://github.com/fllstck/foldkit-flow/issues"
  },
  "author": "Kay Is (https://kay.is)",
  "keywords": [
    "foldkit",
    "flow",
    "node-graph",
    "diagram",
    "canvas",
    "xyflow"
  ]
}
